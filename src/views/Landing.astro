---
/*
 * Landing — the Summons (design spec §3.1). Pure hero: the Seal, the title in
 * inscription type, one hook line, the hot-pink torn-paper CTA (the single
 * loudest element), one duration aside. No sample card — visitors mostly
 * arrive from a shared card, the verdict stays unspoiled, and no dark content
 * appears before the consent gate. Then footer.
 */
import BaseLayout from '../layouts/BaseLayout.astro'
import Seal from '../components/Seal.astro'
import CtaButton from '../components/CtaButton.astro'
import Footer from '../components/Footer.astro'
import LangSuggestBanner from '../components/LangSuggestBanner.astro'
import { t } from '../i18n'
import { localePath, ASTRO_SEGMENT, type Locale } from '../i18n/config'
import { roseWindowSvg } from '../lib/rose-window'

interface Props {
  locale: Locale
}
const { locale } = Astro.props
const showLatin = locale !== 'en'
/* A faint stained-glass halo behind the Seal — the same tracery engine that
 * glazes the 13 special records, here in the witch red (tokens.css
 * --witch-red, literal hex: the generator emits plain fills). Atmosphere
 * only: no card content appears before the consent gate. */
const halo = roseWindowSvg({ color: '#c42838', motif: 'leaf', magicName: t(locale, 'meta.siteName') })
const seo = {
  routeKey: '/',
  title: t(locale, 'meta.siteName'),
  description: t(locale, 'meta.descLanding'),
  ogImage: `/og/${ASTRO_SEGMENT[locale]}/root.png`,
  ogType: 'website' as const,
  jsonld: ['website', 'quiz'] as ('website' | 'quiz' | 'creativework')[],
}
---

<BaseLayout locale={locale} seo={seo}>
  <LangSuggestBanner locale={locale} />
  <main id="main">
    <section class="hero">
      <div class="hero__glass" aria-hidden="true"></div>
      <div class="hero__content">
        <div class="hero__crest">
          <div class="hero__halo" aria-hidden="true" set:html={halo} />
          <Seal size={92} stained glow class="hero__seal" title={t(locale, 'meta.siteName')} />
        </div>
        <h1 class="hero__title inscription">{t(locale, 'landing.title')}</h1>
        {showLatin && <p class="hero__latin instrument">{t(locale, 'meta.latin')}</p>}
        <p class="hero__hook">{t(locale, 'landing.hook')}</p>
        <p class="hero__promise">{t(locale, 'landing.promise')}</p>
        <div class="hero__cta">
          <CtaButton href={localePath(locale, '/exam/')} label={t(locale, 'landing.ctaBegin')} />
        </div>
        <p class="hero__aside">{t(locale, 'landing.ctaAside')}</p>
      </div>
    </section>
  </main>
  <Footer locale={locale} />
</BaseLayout>

<style>
  .hero {
    position: relative;
    min-height: 100svh;
    display: grid;
    place-items: center;
    padding: clamp(2rem, 8vh, 5rem) 1.2rem;
    overflow: hidden;
    text-align: center;
  }
  /* CSS-built stained-glass drift glow — atmosphere, not a screenshot. */
  .hero__glass {
    position: absolute;
    inset: -20%;
    z-index: 0;
    background:
      radial-gradient(40% 30% at 24% 18%, rgba(79, 134, 184, 0.16), transparent 70%),
      radial-gradient(36% 28% at 78% 22%, rgba(235, 139, 121, 0.12), transparent 70%),
      radial-gradient(52% 40% at 50% 6%, rgba(161, 125, 222, 0.14), transparent 72%),
      radial-gradient(60% 44% at 50% 108%, rgba(92, 15, 26, 0.3), transparent 60%);
    animation: glass-drift 26s ease-in-out infinite alternate;
    pointer-events: none;
  }
  .hero__content {
    position: relative;
    z-index: 1;
    display: flex;
    flex-direction: column;
    align-items: center;
    max-width: 40rem;
  }
  .hero__case {
    color: var(--bone-faint);
    font-size: 0.82rem;
    letter-spacing: 0.28em;
    text-transform: uppercase;
    margin-bottom: 1.8rem;
  }
  .hero__crest {
    position: relative;
    display: grid;
    place-items: center;
    margin-bottom: 1.4rem;
  }
  .hero__seal {
    position: relative;
    z-index: 1;
    color: var(--verdict-gold);
  }
  /* the stained-glass halo: a slow-turning rose window at low opacity behind
     the Seal — depth without a screenshot, no content before the gate */
  .hero__halo {
    position: absolute;
    left: 50%;
    top: 50%;
    width: clamp(260px, 62vw, 440px);
    aspect-ratio: 1;
    transform: translate(-50%, -50%);
    opacity: 0.17;
    pointer-events: none;
    animation: halo-turn 140s linear infinite;
    -webkit-mask-image: radial-gradient(circle, #000 35%, transparent 72%);
    mask-image: radial-gradient(circle, #000 35%, transparent 72%);
  }
  .hero__halo :global(svg) {
    width: 100%;
    height: 100%;
  }
  @keyframes halo-turn {
    to { transform: translate(-50%, -50%) rotate(360deg); }
  }
  @media (prefers-reduced-motion: reduce) {
    .hero__halo { animation: none; }
  }
  .hero__title {
    font-size: clamp(2.5rem, 8.5vw, 4.4rem);
    color: var(--bone);
    letter-spacing: 0.12em;
    line-height: 1.08;
    text-shadow: 0 2px 30px rgba(0, 0, 0, 0.6);
  }
  /* CJK inscription carries the wordmark weight (900 shipped for zh, 800 for ja) */
  :global([lang='zh-CN'] .hero__title),
  :global([lang='zh-TW'] .hero__title) {
    font-weight: 900;
  }
  :global([lang='ja'] .hero__title) {
    font-weight: 800;
  }
  .hero__latin {
    margin-top: 0.9rem;
    color: var(--verdict-gold-deep);
    font-size: clamp(0.72rem, 2.2vw, 0.92rem);
    letter-spacing: 0.42em;
    padding-left: 0.42em;
  }
  .hero__hook {
    margin-top: 1.8rem;
    font-family: var(--font-body);
    font-size: clamp(1.1rem, 3.4vw, 1.4rem);
    color: var(--bone-dim);
    font-style: var(--font-style-em);
    /* wide enough that every locale's hook sits on ONE desktop line (em, not
     * ch — a ch is half a CJK glyph); when a narrow viewport forces a wrap,
     * balance + strict kinsoku keep the break legal (no line-leading っ) */
    max-width: min(30em, 100%);
    text-wrap: balance;
    line-break: strict;
  }
  /* what the record will hold — the one promise line, still in register */
  .hero__promise {
    margin-top: 1rem;
    font-family: var(--font-body);
    font-size: clamp(0.95rem, 2.6vw, 1.05rem);
    line-height: 1.7;
    color: var(--bone-faint);
    max-width: min(30em, 100%);
    text-wrap: balance;
    line-break: strict;
  }
  .hero__cta {
    margin-top: 2.4rem;
  }
  .hero__aside {
    margin-top: 1.3rem;
    font-family: var(--font-instrument);
    font-size: 0.86rem;
    letter-spacing: 0.05em;
    color: var(--bone-faint);
    /* em, not ch: a ch is a Latin zero — half a CJK glyph — and 34ch used to
     * force a mid-word break in every CJK locale ("通常二十…" split at 二/十) */
    max-width: min(26em, 100%);
    text-wrap: balance;
  }
  .hero__scroll {
    position: absolute;
    bottom: 1.6rem;
    left: 50%;
    transform: translateX(-50%);
    color: var(--bone-faint);
    font-size: 0.74rem;
    letter-spacing: 0.2em;
    opacity: 0.7;
    z-index: 1;
  }

</style>
